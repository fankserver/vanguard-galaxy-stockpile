<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>VGStockpile</AssemblyName>
    <Product>Stockpile</Product>
    <Version>0.9.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>VGStockpile</RootNamespace>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" IncludeAssets="compile" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.2.6" IncludeAssets="compile" />
    <!-- Ships at runtime (CopyLocalLockFileAssemblies → bin → deploy): game
         0.8.1 removed Newtonsoft.Json.dll from Managed/, so plugins must carry it. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" IncludeAssets="compile;runtime" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="VGModAPI.Abstractions">
      <HintPath>lib/VGModAPI.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Optional typed Unity bridge; shipped by the API package, never bundled here. -->
    <Reference Include="VGModAPI.Unity">
      <HintPath>lib/VGModAPI.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp" Condition="Exists('lib/Assembly-CSharp.dll')">
      <HintPath>lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Owner-local UI references, compile-only and never tracked or packaged. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>lib/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>lib/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VGStockpile.Tests" />
  </ItemGroup>

</Project>
